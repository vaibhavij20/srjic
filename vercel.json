{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets|robots.txt|sitemap.xml|llms.txt|favicon.svg|google.*\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
